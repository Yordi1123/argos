# ARGOS · Variables de entorno de Docker Compose
# Copiar a .env y cambiar la contraseña:  cp .env.example .env

# Base de datos
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Puertos publicados en la laptop (solo 127.0.0.1 salvo PANEL_HOST)
DB_PUERTO=5432
API_PUERTO=8000
PANEL_PUERTO=8080

# 127.0.0.1 = panel solo en esta laptop. En alpha el login con Google solo funciona en localhost.
PANEL_HOST=127.0.0.1

# Autenticación ------------------------------------------------------------------
# Implementación futura: inicio de sesión con Google. Vacío = el panel muestra el botón solo como ilustrativo.
# OAuth Client ID de Google Cloud (tipo "Aplicación web"). No es un secreto. Guía: README.md.
GOOGLE_CLIENT_ID=

# Claves de servicio para el agente de captura y el módulo de visión (las lee agente/simulador.py).
# Se generan con: docker compose exec backend python -m app.claves crear agente OPERADOR
ARGOS_CLAVE_AGENTE=
ARGOS_CLAVE_VISION=

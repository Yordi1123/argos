# ARGOS · Variables de entorno de Docker Compose
# Copiar a .env y cambiar la contraseña:  cp .env.example .env

# Base de datos
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=cambiar_esta_contrasena

# Puertos publicados en la laptop (solo 127.0.0.1 salvo PANEL_HOST)
DB_PUERTO=5432
API_PUERTO=8000
PANEL_PUERTO=8080

# 127.0.0.1 = panel solo en esta laptop; 0.0.0.0 = accesible desde la red local
PANEL_HOST=127.0.0.1
